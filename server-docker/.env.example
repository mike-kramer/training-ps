# Copy to .env and fill in real values. Do not commit .env.

# Public hostname (DNS A/AAAA must point to this server before Certbot).
DOMAIN=app.example.com
CERTBOT_EMAIL=admin@example.com

# nginx template file name inside ./nginx/templates/
# Before certificates: default.http-only.conf.template
# After certificates:  default.conf.template
NGINX_TEMPLATE=default.http-only.conf.template

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# PostgreSQL (not published to the host)
POSTGRES_DB=training-ps
POSTGRES_USER=training-ps
POSTGRES_PASSWORD=change-me-strong-db-password

# Redis (not published to the host)
REDIS_PASSWORD=change-me-strong-redis-password
